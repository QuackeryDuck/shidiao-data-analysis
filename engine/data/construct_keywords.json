  "theory_map": [
    {
      "keywords": [
        "性别",
        "年级",
        "生活费",
        "年龄",
        "学历",
        "月收入",
        "职业"
      ],
      "theory": "消费者行为理论（个体差异视角）",
      "note": "人口统计特征通过资源约束、生活方式与社会角色影响消费行为"
    },
    {
      "keywords": [
        "满意",
        "服务质量",
        "体验"
      ],
      "theory": "期望不一致理论 / SERVPERF 服务质量理论",
      "note": "满意度通常由感知绩效与期望比较形成"
    },
    {
      "keywords": [
        "购买意愿",
        "购买",
        "选择"
      ],
      "theory": "计划行为理论（TPB）/ 技术接受模型（TAM）",
      "note": "态度、主观规范与感知行为控制影响行为意愿"
    },
    {
      "keywords": [
        "品牌",
        "形象",
        "认知"
      ],
      "theory": "品牌资产理论（Keller）",
      "note": "品牌认知、形象与忠诚构成品牌资产"
    },
    {
      "keywords": [
        "价值",
        "功能",
        "情感",
        "社会"
      ],
      "theory": "Sheth-Newman-Gross 消费价值理论",
      "note": "功能、社会、情感、认知与条件价值共同驱动选择"
    },
    {
      "keywords": [
        "购买链路",
        "注意",
        "搜索",
        "分享"
      ],
      "theory": "AISAS 消费者行为模型",
      "note": "注意—兴趣—搜索—行动—分享五阶段"
    },
    {
      "keywords": [
        "信任",
        "承诺"
      ],
      "theory": "信任—承诺理论",
      "note": "信任与承诺是关系维持的核心中介"
    },
    {
      "keywords": [
        "环境",
        "氛围",
        "刺激",
        "体验"
      ],
      "theory": "SOR（刺激—有机体—反应）模型",
      "note": "环境刺激通过情绪与认知影响行为反应"
    },
    {
      "keywords": [
        "价格",
        "性价比",
        "感知价值"
      ],
      "theory": "感知价值理论 / 价格公平理论",
      "note": "感知价值是价格与购买意愿之间的关键机制"
    },
    {
      "keywords": [
        "从众",
        "社会",
        "群体",
        "口碑"
      ],
      "theory": "社会影响理论",
      "note": "规范性与信息性社会影响改变个体态度与行为"
    },
    {
      "keywords": [
        "渠道",
        "便利",
        "触达"
      ],
      "theory": "渠道便利理论与交易成本理论",
      "note": "渠道便利性与交易成本影响渠道选择"
    },
    {
      "keywords": [
        "健康",
        "绿色",
        "可持续"
      ],
      "theory": "计划行为理论 / 价值—信念—规范理论",
      "note": "健康与环保价值观通过信念影响行为"
    },
    {
      "keywords": [
        "技术",
        "接受",
        "使用"
      ],
      "theory": "技术接受模型（TAM）/ UTAUT",
      "note": "感知有用性与易用性影响技术接受"
    }
  ],
  "default_controls": [
    {
      "name": "性别",
      "levels": "男/女/其他/不愿透露",
      "measure": "定类",
      "note": "用于群体差异分析与控制"
    },
    {
      "name": "年龄",
      "levels": "按 18 岁以下、18—25、26—35、36—45、46—60、60 岁以上分组",
      "measure": "定序",
      "note": "按研究总体调整分组"
    },
    {
      "name": "学历",
      "levels": "高中及以下/专科/本科/硕士及以上",
      "measure": "定序",
      "note": "学生样本可改为年级"
    },
    {
      "name": "职业",
      "levels": "学生/企业职员/公务员或事业单位/自由职业/个体经营/退休/其他",
      "measure": "定类",
      "note": "按研究情境调整"
    },
    {
      "name": "月可支配收入",
      "levels": "按当地收入水平分组",
      "measure": "定序",
      "note": "学生可改为月生活费"
    },
    {
      "name": "所在地区",
      "levels": "按省/市/城乡分组",
      "measure": "定类",
      "note": "用于区域配额与代表性检验"
    }
  ]
